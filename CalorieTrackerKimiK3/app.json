{
  "expo": {
    "name": "CalTrack",
    "slug": "CalorieTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calorietracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.caltrack.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.caltrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#101418",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101418",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CalTrack uses the camera to photograph your meals and estimate calories and macros."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "CalTrack lets you pick an existing photo of a meal to estimate calories and macros."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "CalTrack syncs your logged meals with Apple Health.",
          "NSHealthUpdateUsageDescription": "CalTrack writes your logged calories and macros to Apple Health.",
          "background": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B6F04A",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.caltrack.app.widgets",
          "groupIdentifier": "group.com.caltrack.app",
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today's Calories",
              "description": "See today's calorie and macro progress at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
