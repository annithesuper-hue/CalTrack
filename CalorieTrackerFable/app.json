{
  "expo": {
    "name": "CalTrack",
    "slug": "CalorieTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calorietracker",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.notjust.caltrack",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.notjust.caltrack",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "CalTrack uses the camera to snap photos of your meals to estimate calories and macros.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "CalTrack reads nutrition data to keep your food log in sync with Apple Health.",
          "NSHealthUpdateUsageDescription": "CalTrack saves the calories and macros you log to Apple Health.",
          "background": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "dev.notjust.caltrack.widgets",
          "groupIdentifier": "group.dev.notjust.caltrack",
          "widgets": [
            {
              "name": "CalTrackWidget",
              "displayName": "Daily Progress",
              "description": "Calories remaining and macros for today.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
